# Dev local branché sur les services de PRODUCTION (mode Vite `prod-local`).
# Copier en `.env.prod-local.local` (ignoré par git) :
#   cp .env.prod-local.example .env.prod-local.local
# Puis lancer `scripts/dev-prod.sh` (certificat + /etc/hosts + Vite sur 443).
VITE_API_URL=https://api.joutio.com
VITE_OIDC_AUTHORITY=https://identity.joutio.com
VITE_OIDC_CLIENT_ID=web
VITE_OIDC_REDIRECT_URI=https://app.joutio.com/callback
